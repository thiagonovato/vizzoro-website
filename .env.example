# Copy to .env.local for local development. In Firebase App Hosting,
# store the production value in Cloud Secret Manager.

# Resend (https://resend.com), used by src/app/api/contact/route.ts to
# email contact-form submissions to info@vizzoro.com.
# Referenced by apphosting.yaml as the secret named resendApiKey.
RESEND_API_KEY=
